# انسخ الملف ده لـ .env واملأ القيم الحقيقية وقت النشر الفعلي

# سر توقيع الـJWT — لازم يتغيّر لقيمة عشوائية طويلة قبل أي استضافة حقيقية على الإنترنت
QCP_JWT_SECRET=

# اتركه فاضي في التطوير المحلي (هيستخدم ملف SQLite محلي تلقائيًا في ./data)
# لما تجهز Turso: حط رابط الاتصال بتاعه هنا
QCP_DB_URL=
QCP_DB_AUTH_TOKEN=

# منفذ السيرفر
PORT=4000
